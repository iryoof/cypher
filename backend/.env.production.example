# Backend Environment (production, e.g. Render)
NODE_ENV=production
PORT=3000

# CORS allowlist: comma-separated browser origins (no path, no trailing slash)
FRONTEND_URL=https://iryoof.github.io,http://localhost:5173

# Archive settings
ARCHIVE_DIR=./archives
MAX_ARCHIVE_SIZE=1000

# Game settings
MAX_LOBBIES=100
LOBBY_TIMEOUT=3600000
